# BAiTI environment variables — copy to .env and fill in. NEVER commit .env.
# Contract source: docs/blueprint/03_ARCHITECTURE.md §8

# --- database (dev values match infra/docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/baiti
# runtime pool — non-owner role, subject to RLS (NOBYPASSRLS)
DB_APP_USER=baiti_app
DB_APP_PASSWORD=change-me-app
# Schema owner — Flyway and the explicitly annotated internal platform lookup
DB_MIGRATOR_USER=baiti_migrator
DB_MIGRATOR_PASSWORD=change-me-migrator
# compose bootstrap (postgres superuser inside the dev container only)
POSTGRES_DB=baiti
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser

# --- auth ---
# Base64 encoding of >=32 random bytes; required in every main profile, no default.
# Example generator: openssl rand -base64 48 (deliver through the environment/secret store).
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- http ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_LOGIN_PER_MINUTE=5

# --- storage (dev: local filesystem; prod S3_* vars arrive with the S3 impl) ---
STORAGE_ROOT=./storage

# --- tenancy (prod subdomain resolver) ---
APP_BASE_DOMAIN=baiti.app

# --- frontend (frontend/.env.local) ---
VITE_API_URL=http://localhost:8080
VITE_TENANT_SLUG=sunrise-towers
